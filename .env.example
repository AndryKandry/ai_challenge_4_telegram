# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Yandex Cloud Configuration
# Получите API ключ в консоли Yandex Cloud (создайте сервисный аккаунт с ролью ai.languageModels.user)
YANDEX_API_KEY=your_yandex_api_key_here

# ID каталога в Yandex Cloud (обязательный параметр для Yandex GPT)
# Найдите в консоли Yandex Cloud в разделе "Обзор"
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# OpenAI Configuration (опционально)
# Получите API ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek Configuration (опционально)
# Получите API ключ на https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Опциональные параметры
# REQUEST_TIMEOUT=30
# OPENAI_MODEL=gpt-3.5-turbo
# DEEPSEEK_MODEL=deepseek-chat

# Telegram API credentials (required for Telegram Assistant MCP and Auto Summaries)
# Получите на https://my.telegram.org/apps
# ВАЖНО: После настройки запустите один раз: python setup_telegram_session.py
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Database paths for Auto Summaries system
DATABASE_URL=data/assistants.db
SCHEDULER_DB_URL=data/scheduler_jobs.db

# Scheduler settings
SCHEDULER_TIMEZONE=UTC
MAX_ASSISTANTS_PER_USER=10
MIN_INTERVAL_MINUTES=1
